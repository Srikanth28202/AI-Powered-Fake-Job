# backend/.env.example
# Copy this file to .env inside backend/ or root and fill in your actual values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Fake Job Detection API"
APP_VERSION=1.0.0
DEBUG=false

# ── Server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ── MongoDB Atlas ────────────────────────────────────────────
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fake_job_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=fake_job_db
MONGODB_CONNECT_TIMEOUT_MS=5000

# ── Security & JWT Auth ──────────────────────────────────────
JWT_SECRET_KEY=replace-this-with-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS Origins ─────────────────────────────────────────────
# Comma-separated origins allowed to make cross-origin requests
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── ML Artifacts ─────────────────────────────────────────────
ML_MODEL_PATH=../ml/models/fake_job_model.pkl
ML_VECTORIZER_PATH=../ml/models/tfidf_vectorizer.pkl
ML_PIPELINE_PATH=../ml/models/full_pipeline.pkl
ML_CONFIDENCE_THRESHOLD=0.50

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
